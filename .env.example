# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL JDBC URL (database must exist; docker-compose.yml creates post_db)
DB_URL=jdbc:postgresql://localhost:5432/post_db
# Database user name
DB_USERNAME=postgres
# Database password (same value as POSTGRES_PASSWORD for docker-compose)
DB_PASSWORD=change-me

# Secret used to sign JWT tokens. At least 32 bytes. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes
# Token lifetime in minutes
JWT_EXPIRATION_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial admin account, created on first start if it does not exist yet
ADMIN_USERNAME=admin
# Password for the initial admin account. If empty, no admin is created.
ADMIN_PASSWORD=change-me-admin-password
